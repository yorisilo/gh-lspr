#!/bin/bash
set -e

# 自分の GitHub ユーザー名を設定
GITHUB_USER=$(gh api user -q .login)

# 環境変数から除外するリポジトリを取得（カンマ区切り）
# e.g. export IGNORE_REPOSITORIES="owner/repo1,owner/repo2"
IFS=',' read -r -a ignore_repository <<< "${IGNORE_REPOSITORIES:-}"
# ignore_repository リストを文字列に変換
ignore_repository_query=$(printf -- "-repo:%s " "${ignore_repository[@]}")

limit=100

# for pull request related me
filtered_prs_query=''
requested_prs_query="is:open is:pr review-requested:@me sort:updated-desc $ignore_repository_query"
created_prs_query="is:open is:pr author:@me sort:updated-desc $ignore_repository_query"
mentioned_prs_query="is:open is:pr mentions:@me sort:updated-desc $ignore_repository_query"
reviewed_prs_query="is:open is:pr reviewed-by:@me sort:updated-desc $ignore_repository_query" # reviewed_prs_query を承認済みフラグとして利用
assigned_prs_query="is:open is:pr assignee:@me sort:updated-desc $ignore_repository_query"

# for issue related me
created_issues_query="is:open is:issue author:@me sort:updated-desc $ignore_repository_query"
mentioned_issues_query="is:open is:issue mentions:@me sort:updated-desc $ignore_repository_query"
assigned_issues_query="is:open is:issue assignee:@me sort:updated-desc $ignore_repository_query"

# for pullrequest related team
# ...

# for issue related team
# ...

org=''

fetch_issue_pr_list() {
  local query='
    fragment pr on PullRequest {
      number
      title
      url
      updatedAt
      createdAt
      author {
        login
      }
      repository {
        name
      }
      reviews(first: 10 states: [APPROVED]) {
        nodes {
          state
          author {
            login
          }
        }
      }
    }

    fragment issue on Issue {
      number
      title
      url
      createdAt
      updatedAt
      repository {
        name
      }
      author {
        login
      }
      labels(first: 10) {
        nodes {
          name
        }
      }
    }

    query(
      \$createdPRQuery: String!,
      # \$requestedPRQuery: String!,
      # \$mentionedPRQuery: String!,
      # \$reviewedPRQuery: String!,
      \$assignedPRQuery: String!,
      \$createdIssueQuery: String!,
      # \$mentionedIssueQuery: String!,
      \$assignedIssueQuery: String!,
      \$limit: Int = 10
    ) {
      createdPR: search(first: \$limit, type: ISSUE, query: \$createdPRQuery) {
        nodes { ...pr }
      }
      # requestedPR: search(first: \$limit, type: ISSUE, query: \$requestedPRQuery) {
      #   nodes { ...pr }
      # }
      # mentionedPR: search(first: \$limit, type: ISSUE, query: \$mentionedPRQuery) {
      #   nodes { ...pr }
      # }
      # reviewedPR: search(first: \$limit, type: ISSUE, query: \$reviewedPRQuery) {
      #   nodes { ...pr }
      # }
      assignedPR: search(first: \$limit, type: ISSUE, query: \$assignedPRQuery) {
        nodes { ...pr }
      }
      createdIssue: search(first: \$limit, type: ISSUE, query: \$createdIssueQuery) {
        nodes { ...issue }
      }
      # mentionedIssue: search(first: \$limit, type: ISSUE, query: \$mentionedIssueQuery) {
      #   nodes { ...issue }
      # }
      assignedIssue: search(first: \$limit, type: ISSUE, query: \$assignedIssueQuery) {
        nodes { ...issue }
      }
    }
  '

  local result
  result=$(gum spin --spinner "dot" --title "fetching..." -- sh -c "gh api graphql \
    -F createdPRQuery=\"$1\" \
    -F requestedPRQuery=\"$2\" \
    -F mentionedPRQuery=\"$3\" \
    -F reviewedPRQuery=\"$4\" \
    -F assignedPRQuery=\"$5\" \
    -F createdIssueQuery=\"$6\" \
    -F mentionedIssueQuery=\"$7\" \
    -F assignedIssueQuery=\"$8\" \
    -F limit=\"$limit\" \
    -f query=\"$query\"")
  echo "$result"
}

issue_pr_list=$(fetch_issue_pr_list "$created_prs_query" "$requested_prs_query" "$mentioned_prs_query" "$reviewed_prs_query" "$assigned_prs_query" "$created_issues_query" "$mentioned_issues_query" "$assigned_issues_query")

# debug
