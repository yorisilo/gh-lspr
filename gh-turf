timeago() {
  # 引数が空なら何も返さない
  if [ -z "$1" ]; then
    echo ""
    return
  fi

  # 例: "2023-10-07T06:37:16.123Z" または "2023-10-07T06:37:16Z"
  local iso_date="$1"

  # 末尾の "Z" を削除
  iso_date="${iso_date%Z}"
  # 小数点以下の部分があれば除去 (例: "2023-10-07T06:37:16.123" → "2023-10-07T06:37:16")
  iso_date="${iso_date%%.*}"

  # 空文字になっていないかチェック
  if [ -z "$iso_date" ]; then
    echo ""
    return
  fi

  # BSD date では -d オプションは使えないので、-j -f を利用してパースする
  # ISO 文字列は元々 UTC なので、TZ=UTC を指定してパースする
  local ts
  ts=$(TZ=UTC date -j -f "%Y-%m-%dT%H:%M:%S" "$iso_date" +"%s" 2>/dev/null)
  if [ -z "$ts" ]; then
    # パースに失敗した場合は空文字を返す
    echo ""
    return
  fi

  local now
  now=$(date +"%s")
  local diff=$(( now - ts ))

  if [ $diff -lt 60 ]; then
    echo "${diff}s ago"
  elif [ $diff -lt 3600 ]; then
    echo "$(( diff / 60 ))m ago"
  elif [ $diff -lt 86400 ]; then
    echo "$(( diff / 3600 ))h ago"
  else
    echo "$(( diff / 86400 ))d ago"
  fi
}

trim() {
  sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//'
}

# 次に、ヘッダー以外の各行の UPDATE-TIME 列を timeago 関数で変換する
final_table=$(echo "$table" | tail -n +2 | while IFS=$'\t' read -r title url author updated; do
  new_update=$(timeago "$updated")
  echo -e "${title}\t${url}\t${author}\t${new_update}"
done)

# ヘッダー行を付与して全体のテーブルを作成
header_table=$( {
  echo -e "TITLE\tURL\tAUTHOR\tUPDATE-TIME"
  echo "$final_table"
} )

# 列をタブ区切りを空白を使って綺麗に整形する
formatted_table=$(echo "$header_table" | column -t -s $'\t')
selected_row=$(echo "$formatted_table" | fzf --header-lines=1 --header="PR and ISSUE list:" --reverse --cycle --height ${FZF_TMUX_HEIGHT:-60%} --no-sort --exact)
selected_url=$(echo "$selected_row" | awk -F ' ' '{print $2}' | trim)

if [ -n "$selected_url" ]; then
  echo "Selected URL: $selected_url"
  # MacOSの場合は open、Linuxの場合は xdg-open などを利用
  open "$selected_url"
fi
